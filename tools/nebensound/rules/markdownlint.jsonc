{
  // The pipeline's default for Markdownlint. `check-markdown` lays a
  // repository's own configuration over it rule by rule, so the repository
  // names only the rules it wants different, and a rule it does not name
  // keeps the value given here, also after this file changes. The tool
  // compiles it in to say which rules a repository sets differently.
  //
  // Prettier does not wrap prose and aligns tables, so a line length is not a
  // rule it could keep.
  "MD013": false,
}
